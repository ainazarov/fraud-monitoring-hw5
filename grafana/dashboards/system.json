        "type": "prometheus",
        "uid": "prometheus"
      },
      "pluginVersion": "11.6.0",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * (1 - avg by (instance) (rate(node_cpu_seconds_total{instance=~\"$instance\",mode=\"idle\"}[$__rate_interval])))",
          "legendFormat": "",
