    {
      "id": 9,
      "title": "Merchant exposure",
      "type": "table",
      "description": "Top 20 merchants by flagged amount. Small samples may produce unstable fraud fractions; inspect the transaction count.",
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "postgres",
