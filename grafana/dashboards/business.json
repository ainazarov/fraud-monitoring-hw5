    {
      "id": 7,
      "title": "Fraud fraction by category \u00b7 latest 1,000 overall",
      "type": "barchart",
      "description": "First select the most recent 1,000 committed transactions globally using sequence DESC; then apply state/merchant filters; then compute flagged / category sample size. This rolling population intentionally ignores the dashboard time picker.",
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "postgres",
        "uid": "postgres"
      },
      "pluginVersion": "11.6.0",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "postgres"
          },
          "rawSql": "WITH latest AS (\n  SELECT cat_id, fraud_flag, us_state, merch FROM scores ORDER BY sequence DESC LIMIT 1000\n)\nSELECT coalesce(nullif(cat_id,''),'unknown') AS category,\n       avg(fraud_flag::double precision) AS fraud_fraction\nFROM latest WHERE ('__all' IN (${us_state:sqlstring}) OR coalesce(nullif(us_state,''),'unknown') IN (${us_state:sqlstring}))\n  AND ('__all' IN (${merch:sqlstring}) OR coalesce(nullif(merch,''),'unknown') IN (${merch:sqlstring}))\nGROUP BY 1 ORDER BY fraud_fraction DESC, category",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "palette-classic"
