            "uid": "postgres"
          },
          "rawSql": "SELECT coalesce(nullif(merch,''),'unknown') AS merchant, count(*) AS transactions, sum(fraud_flag) AS flagged, avg(fraud_flag::double precision) AS fraud_fraction, coalesce(sum(amount) FILTER (WHERE fraud_flag=1),0) AS flagged_amount FROM scores WHERE $__timeFilter(processed_at) AND ('__all' IN (${us_state:sqlstring}) OR coalesce(nullif(us_state,''),'unknown') IN (${us_state:sqlstring}))\n  AND ('__all' IN (${merch:sqlstring}) OR coalesce(nullif(merch,''),'unknown') IN (${merch:sqlstring})) GROUP BY 1 ORDER BY flagged_amount DESC, transactions DESC LIMIT 20",
          "format": "table",
