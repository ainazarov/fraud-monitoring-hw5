    {
      "id": 5,
      "title": "Filtered score probability density",
      "type": "barchart",
      "description": "20 equal bins of width 0.05. Density = bin count / (filtered sample size \u00d7 0.05), so area sums to one; density can exceed one. Score 1 belongs to the last bin. Empty selection has no defined density.",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "postgres",
        "uid": "postgres"
      },
      "pluginVersion": "11.6.0",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "postgres"
          },
          "rawSql": "WITH filtered AS (\n  SELECT least(floor(score * 20)::integer, 19) AS bin FROM scores WHERE $__timeFilter(processed_at) AND ('__all' IN (${us_state:sqlstring}) OR coalesce(nullif(us_state,''),'unknown') IN (${us_state:sqlstring}))\n  AND ('__all' IN (${merch:sqlstring}) OR coalesce(nullif(merch,''),'unknown') IN (${merch:sqlstring}))\n), counts AS (SELECT bin, count(*) AS n FROM filtered GROUP BY bin),\ntotal AS (SELECT count(*)::double precision AS n FROM filtered)\nSELECT to_char(b.bin * 0.05, '0.00') || '-' || to_char((b.bin + 1) * 0.05, '0.00') AS score_bin,\n       coalesce(c.n,0) / nullif(t.n * 0.05,0) AS density\nFROM generate_series(0,19) b(bin) CROSS JOIN total t LEFT JOIN counts c USING (bin)\nORDER BY b.bin",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": [],
          "noValue": "No data",
          "custom": {
            "fillOpacity": 85,
            "lineWidth": 0,
            "axisPlacement": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "auto",
        "barWidth": 0.8,
        "groupWidth": 0.85,
        "showValue": "never",
        "stacking": "none",
        "xTickLabelRotation": -45,
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "title": "Filtered processing TPS",
      "type": "timeseries",
      "description": "Counts durable transactions by processed_at, the scorer's actual wall-clock processing time, not historical transaction_time or database insertion time. Empty buckets are zero; partial boundary buckets use their actual duration.",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "postgres",
        "uid": "postgres"
      },
      "pluginVersion": "11.6.0",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "postgres"
          },
          "rawSql": "WITH settings AS (\n  SELECT greatest($__interval_ms / 1000.0, 1) AS width,\n         extract(epoch FROM $__timeFrom()::timestamptz) AS start_s,\n         extract(epoch FROM $__timeTo()::timestamptz) AS end_s\n), buckets AS (\n  SELECT generate_series(floor(start_s/width)::bigint, ceil(end_s/width)::bigint-1) AS bucket,\n         width, start_s, end_s FROM settings\n), counts AS (\n  SELECT floor(extract(epoch FROM processed_at) / s.width)::bigint AS bucket, count(*) AS n\n  FROM scores CROSS JOIN settings s WHERE $__timeFilter(processed_at) AND ('__all' IN (${us_state:sqlstring}) OR coalesce(nullif(us_state,''),'unknown') IN (${us_state:sqlstring}))\n  AND ('__all' IN (${merch:sqlstring}) OR coalesce(nullif(merch,''),'unknown') IN (${merch:sqlstring})) GROUP BY 1\n)\nSELECT to_timestamp(greatest(b.bucket*b.width,b.start_s)) AS time,\n       coalesce(c.n,0)::double precision / nullif(least((b.bucket+1)*b.width,b.end_s)-greatest(b.bucket*b.width,b.start_s),0) AS tps\nFROM buckets b LEFT JOIN counts c USING (bucket) ORDER BY time",
          "format": "time_series",
          "editorMode": "code",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": [],
          "noValue": "No data",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": false,
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "min": 0
        },
        "overrides": []
      },
