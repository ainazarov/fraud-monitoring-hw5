{
  "id": null,
  "uid": "hw5-scoring",
  "title": "HW5 / Scoring pulse",
  "description": "Scorer throughput, decisions and model changes. Process metrics count successful emitted scores; SQL panels describe durable records in the selected processing-time range.",
  "tags": [
    "hw5",
    "fraud-monitoring",
    "original"
  ],
  "timezone": "browser",
  "schemaVersion": 40,
  "version": 1,
  "editable": false,
  "style": "dark",
  "graphTooltip": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "links": [
    {
      "title": "Scoring",
      "url": "/d/hw5-scoring",
      "type": "link",
      "includeVars": false,
      "keepTime": true
    },
    {
      "title": "Writer",
      "url": "/d/hw5-writer",
      "type": "link",
      "includeVars": false,
      "keepTime": true
    },
    {
      "title": "System",
      "url": "/d/hw5-system",
      "type": "link",
      "includeVars": false,
      "keepTime": true
    },
    {
      "title": "Business",
      "url": "/d/hw5-business",
      "type": "link",
      "includeVars": false,
      "keepTime": true
    }
