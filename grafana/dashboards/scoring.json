  "annotations": {
    "list": [
      {
        "name": "Model activations",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "hide": false,
        "iconColor": "#B877D9",
        "expr": "(fw_model_activated_timestamp_seconds > (time() - 30)) * 1000",
        "step": "10s",
        "useValueForTime": true,
        "tagKeys": "version",
        "titleFormat": "Model {{version}} activated",
        "textFormat": "The scorer successfully loaded model {{version}}. The marker uses the actual activation timestamp."
      }
    ]
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Scoring throughput \u00b7 30s",
      "type": "stat",
      "description": "Successfully emitted scores per second, averaged over 30 seconds.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "pluginVersion": "11.6.0",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(fw_transactions_total[30s]))",
          "legendFormat": "",
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "time_series",
          "exemplar": false
