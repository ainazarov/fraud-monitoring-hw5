    {
      "id": 11,
      "title": "Latest committed scores",
      "type": "table",
      "description": "Newest 100 committed transactions in the selected write-time range. Transaction context is stored in PostgreSQL, never as high-cardinality metric labels.",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "postgres",
        "uid": "postgres"
      },
      "pluginVersion": "11.6.0",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "postgres"
          },
          "rawSql": "SELECT transaction_id, model_version, score, fraud_flag, us_state, merch, cat_id, amount, processed_at, scored_at, extract(epoch FROM (scored_at-processed_at)) AS delivery_seconds FROM scores WHERE $__timeFilter(scored_at) ORDER BY sequence DESC LIMIT 100",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
